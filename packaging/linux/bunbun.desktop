[Desktop Entry]
Type=Application
Name=Bunbun
GenericName=Dynamic Island
Comment=A Dynamic Island with a mascot that watches your coding agents
Exec=bunbun
Icon=bunbun
Terminal=false
Categories=Utility;
Keywords=island;notch;media;agents;claude;mascot;
StartupNotify=false
Actions=Settings;Quit;

[Desktop Action Settings]
Name=Settings
Exec=bunbun --settings

[Desktop Action Quit]
Name=Quit Bunbun
Exec=bunbun --quit
