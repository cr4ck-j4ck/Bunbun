#include <winres.h>

1 RT_MANIFEST "bunbun.manifest"

// Bun, rendered by scripts/make_icon.sh: the icon of bunbun.exe and bunbun-settings.exe.
1 ICON "bunbun.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BUNBUN_VER_COMMA
PRODUCTVERSION BUNBUN_VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Bunbun - Dynamic Island for Windows"
      VALUE "ProductName", "Bunbun"
      VALUE "FileVersion", BUNBUN_VERSION_STR
      VALUE "ProductVersion", BUNBUN_VERSION_STR
      VALUE "OriginalFilename", "bunbun.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
